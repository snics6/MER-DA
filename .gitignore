# ---- 大きくて作り直せるもの ----
# 注意：.gitignore は行末コメントを解釈しない（# は行頭のときだけコメント）．
# 特徴キャッシュ（npz・合計 1.1 GB）
data/cache/*
# 顔の座標（17.6 MB）は入れる．表情モデルを差し替えても同じ画素を切り出せる唯一の手段
!data/cache/faces_*.csv.gz
# 事前学習済みモデルの重み（バイナリ）
weights/

# ---- 環境 ----
**/.venv/
__pycache__/
*.py[cod]

# ---- WSL が付ける残骸 ----
*:Zone.Identifier

# ---- 実行ログ・結果（再計算できる．各結果に設定とコミット番号を書く） ----
logs/
/results/

# ---- paper/（LaTeX の中間生成物と PDF．numbers.tex は生成物だが入れる） ----
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/main.pdf
paper/sections/*.aux
paper/scripts/ledger/.cache/
paper/scripts/ledger/__pycache__/
paper/figures/*.png
paper/supplementary.pdf
paper/supp/*.aux
paper/ja/*.aux
paper/ja/*.bbl
paper/ja/*.blg
paper/ja/*.bibtex.out
paper/ja/*.fdb_latexmk
paper/ja/*.fls
paper/ja/*.log
paper/ja/*.out
paper/ja/*.synctex.gz
paper/ja/*.toc
paper/ja/*.pdf
paper/ja/sections/*.aux
paper/ja/supp/*.aux

# ---- slides/（LaTeX の中間生成物と PDF・PPTX） ----
slides/*/build/
slides/*/*.pdf
slides/*/*.pptx
checks/*/code_run/

# ---- DAI/docs/参照/DAI_paper/参照論文 の PDF（arXiv などから落とし直せる．一覧は同じフォルダの README.md．2026-11-15 に DAI_paper/ から移した） ----
DAI/docs/参照/DAI_paper/参照論文/*.pdf

# ---- DAI/（LaTeX の中間生成物．PDF は入れる） ----
DAI/**/*.aux
DAI/**/*.log
DAI/**/*.out
DAI/**/*.toc
DAI/**/*.synctex.gz

# ---- DAI：検査役の試走の出力（大きい．報告と台本だけ入れる） ----
DAI/checks/*/code_run/out/
DAI/checks/*/code_run*/out/
DAI/docs/*.aux
DAI/docs/*.log
DAI/docs/*.out

# ---- DAI/slides/（LaTeX の中間生成物と PDF） ----
DAI/slides/*/build/
DAI/slides/*/*.pdf
DAI/checks/DAI-eval/code_run_post/*.pkl

# DAI の検査役の試走の出力（判定の値を含む．報告の md は DAI/checks/<実験>/ 直下）
DAI/checks/*/code_run*/
DAI/checks/*/review_*_run*/
DAI/checks/*/claim_run*/

# DAI/archive：論文に使わない実験の検査役の試走の出力（2026-11-15 の整理で archive に移した）
DAI/archive/checks/*/code_run*/

# 2026-11-15：logs は DAI/logs へのリンク
/logs

# ---- 公開用のコードの写し（別のリポジトリ．2026-11-17） ----
/release/
