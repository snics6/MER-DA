# ---- 大きくて作り直せるもの ----
# 注意：.gitignore は行末コメントを解釈しない（# は行頭のときだけコメント）．
# 特徴キャッシュ（npz・合計 1.1 GB）
data/cache/*
# 顔の座標（17.6 MB）は入れる．表情モデルを差し替えても同じ画素を切り出せる唯一の手段
!data/cache/faces_*.csv.gz
# 事前学習済みモデルの重み（バイナリ）
weights/

# ---- 環境 ----
**/.venv/
__pycache__/
*.py[cod]

# ---- WSL が付ける残骸 ----
*:Zone.Identifier

# ---- 実行ログ・結果（再計算できる．各結果に設定とコミット番号を書く） ----
logs/
results/

# ---- paper/（LaTeX の中間生成物と PDF．numbers.tex は生成物だが入れる） ----
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/main.pdf
paper/sections/*.aux
paper/scripts/ledger/.cache/
paper/scripts/ledger/__pycache__/
